# Add to the VM's Caddyfile. The DNS A record must already point at the VM, or
# Caddy cannot answer the certificate challenge and the site stays on HTTP.
# One hostname: /api goes to the API, everything else to the web app.
bahoapp.site, www.bahoapp.site {
	encode gzip
	handle /api/* {
		reverse_proxy baho-backend:4000
	}
	handle {
		reverse_proxy baho-frontend:80
	}
}
