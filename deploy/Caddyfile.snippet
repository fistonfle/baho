# Add to the VM's Caddyfile (replace baho.example.rw with the real hostname,
# whose DNS A record must already point at the VM so Caddy can get a certificate).
# One hostname: /api goes to the API, everything else to the web app.
baho.example.rw {
	encode gzip
	handle /api/* {
		reverse_proxy baho-backend:4000
	}
	handle {
		reverse_proxy baho-frontend:80
	}
}
