# Copy to /app/baho/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -base64 36

POSTGRES_DB=baho
POSTGRES_USER=baho
POSTGRES_PASSWORD=

# Signs login tokens. Must be long, random and used only by Baho.
AUTH_TOKEN_SECRET=

# First administrator, created on the first start when no admin exists.
BAHO_ADMIN_NAME=
BAHO_ADMIN_EMAIL=
BAHO_ADMIN_PASSWORD=

# Docker network that Caddy is on (same as the other stacks on this VM).
CADDY_NETWORK=sagamba-net
