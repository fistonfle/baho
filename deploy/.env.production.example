# Copy to /app/baho/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -base64 36

POSTGRES_DB=baho
POSTGRES_USER=baho
POSTGRES_PASSWORD=

# Signs login tokens. Must be long, random and used only by Baho.
AUTH_TOKEN_SECRET=

# First administrator, created on the first start when no admin exists.
BAHO_ADMIN_NAME=
BAHO_ADMIN_EMAIL=
BAHO_ADMIN_PASSWORD=

# Password reset email (staff accounts). With Gmail use a Google app password,
# created under Google Account > Security > App passwords (2-Step Verification
# must be on); the account password does not work for SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Baho <your-address@gmail.com>
# Public address of the app: the reset links point here.
APP_BASE_URL=https://baho.filito.rw
PASSWORD_RESET_TTL_MINUTES=60

# Docker network that Caddy is on (same as the other stacks on this VM).
CADDY_NETWORK=sagamba-net
