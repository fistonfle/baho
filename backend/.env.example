PORT=4000
# Replace <user> (and add :password if your PostgreSQL user has one)
DATABASE_URL=postgresql://<user>@localhost:5432/baho
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-before-deployment
# First administrator, created on start-up when no admin exists (password: 12+ characters).
# This is the only way to create the first admin; later staff are added by an admin in the app.
BAHO_ADMIN_NAME=
BAHO_ADMIN_EMAIL=
BAHO_ADMIN_PASSWORD=
