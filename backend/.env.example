PORT=4000
# Replace <user> (and add :password if your PostgreSQL user has one)
DATABASE_URL=postgresql://<user>@localhost:5432/baho
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-before-deployment
# First administrator, created on start-up when no admin exists (password: 12+ characters).
# This is the only way to create the first admin; later staff are added by an admin in the app.
BAHO_ADMIN_NAME=
BAHO_ADMIN_EMAIL=
BAHO_ADMIN_PASSWORD=

# Password reset by email (staff accounts). With Gmail, SMTP_USER is the Gmail
# address and SMTP_PASS is a 16-character Google "app password", not the account
# password: turn on 2-Step Verification, then Google Account > Security >
# App passwords. Leave SMTP_USER/SMTP_PASS empty in development and the reset
# link is written to the server log instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Baho <your-address@gmail.com>
# Where the reset link points: the address learners and staff open the app at.
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60
